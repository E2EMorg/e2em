{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy",
  "type": "object",
  "properties": {
    "default_action": {
      "$ref": "#/$defs/Action"
    },
    "id": {
      "type": "string"
    },
    "on_error": {
      "$ref": "#/$defs/Action"
    },
    "on_indeterminate": {
      "$ref": "#/$defs/Action"
    },
    "override": {
      "$ref": "#/$defs/Override"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "profile",
    "rules",
    "default_action",
    "on_indeterminate",
    "on_error",
    "override"
  ],
  "$defs": {
    "Action": {
      "type": "string",
      "enum": [
        "allow",
        "warn",
        "review",
        "block"
      ]
    },
    "ContextRequirement": {
      "type": "string",
      "enum": [
        "target_only",
        "supplied_window"
      ]
    },
    "Direction": {
      "type": "string",
      "enum": [
        "outgoing",
        "incoming"
      ]
    },
    "Match": {
      "type": "string",
      "enum": [
        "detected",
        "score",
        "policy_text"
      ]
    },
    "Override": {
      "type": "string",
      "enum": [
        "user_confirm",
        "forbidden"
      ]
    },
    "Profile": {
      "type": "string",
      "enum": [
        "personal",
        "platform"
      ]
    },
    "Rule": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "action_threshold": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_requirement": {
          "$ref": "#/$defs/ContextRequirement"
        },
        "directions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Direction"
          }
        },
        "id": {
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "min_context_messages": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "model_thresholds": {
          "type": "boolean"
        },
        "policy_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_threshold": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "directions",
        "match",
        "context_requirement",
        "action"
      ]
    }
  }
}
