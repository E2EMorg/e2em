{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string"
    },
    "reply": {
      "$ref": "#/$defs/Reply"
    }
  },
  "additionalProperties": false,
  "required": [
    "call_id",
    "reply"
  ],
  "$defs": {
    "Action": {
      "type": "string",
      "enum": [
        "allow",
        "warn",
        "review",
        "block"
      ]
    },
    "Assessment": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "api_version": {
          "type": "string"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "message_id": {
          "type": "string"
        },
        "message_revision": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "message_id",
        "message_revision",
        "status",
        "action",
        "versions",
        "coverage",
        "findings",
        "reason_codes",
        "duration_ms"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "api_version": {
          "type": "string"
        },
        "backend_ready": {
          "type": "boolean"
        },
        "custom_policies": {
          "type": "string"
        },
        "detectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "model": {
          "type": "string"
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Profile"
          }
        },
        "provider": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "runtime_state": {
          "$ref": "#/$defs/State"
        },
        "tokenizer": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "api_version",
        "provider",
        "runtime",
        "model",
        "tokenizer",
        "registry",
        "languages",
        "detectors",
        "presets",
        "custom_policies",
        "profiles",
        "actions",
        "limits",
        "backend_ready",
        "runtime_state"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "context_complete": {
          "type": "boolean"
        },
        "dropped_context_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "target_complete": {
          "type": "boolean"
        },
        "unevaluated_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "language",
        "target_complete",
        "context_complete",
        "dropped_context_ids",
        "unevaluated_rules"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "UNSUPPORTED_VERSION",
        "POLICY_NOT_FOUND",
        "INVALID_POLICY",
        "UNSUPPORTED_POLICY",
        "MODEL_UNAVAILABLE",
        "DEADLINE_EXCEEDED",
        "RESOURCE_EXHAUSTED",
        "INTERNAL_ERROR"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "reason_code": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "rule_id",
        "method",
        "reason_code",
        "spans"
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "context_turns": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "deadline_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "frame_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "message_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "policy_rules": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "request_text_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "result_spans": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "message_bytes",
        "request_text_bytes",
        "context_turns",
        "policy_rules",
        "frame_bytes",
        "result_spans",
        "deadline_ms"
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "deterministic",
        "model",
        "custom_policy"
      ]
    },
    "PolicyRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "version",
        "token"
      ]
    },
    "Profile": {
      "type": "string",
      "enum": [
        "personal",
        "platform"
      ]
    },
    "Reply": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capabilities": {
              "$ref": "#/$defs/Capabilities"
            },
            "kind": {
              "type": "string",
              "const": "capabilities"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "capabilities"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "policy"
            },
            "policy_ref": {
              "$ref": "#/$defs/PolicyRef"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "policy_ref"
          ]
        },
        {
          "type": "object",
          "properties": {
            "assessment": {
              "$ref": "#/$defs/Assessment"
            },
            "kind": {
              "type": "string",
              "const": "assessment"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "assessment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "accepted"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error_code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "kind": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "error_code"
          ]
        }
      ]
    },
    "Span": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "message_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "message_id",
        "start",
        "end"
      ]
    },
    "State": {
      "type": "string",
      "enum": [
        "unloaded",
        "loading",
        "ready",
        "assessing",
        "evicting",
        "failed"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "assessed",
        "indeterminate",
        "error",
        "cancelled"
      ]
    },
    "Versions": {
      "type": "object",
      "properties": {
        "detectors": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime",
        "model",
        "detectors",
        "registry",
        "policy_id",
        "policy_version"
      ]
    }
  }
}
