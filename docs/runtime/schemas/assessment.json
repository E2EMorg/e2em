{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assessment",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/Action"
    },
    "api_version": {
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "duration_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "message_id": {
      "type": "string"
    },
    "message_revision": {
      "type": "string"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "request_id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/Status"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "message_id",
    "message_revision",
    "status",
    "action",
    "versions",
    "coverage",
    "findings",
    "reason_codes",
    "duration_ms"
  ],
  "$defs": {
    "Action": {
      "type": "string",
      "enum": [
        "allow",
        "warn",
        "review",
        "block"
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "context_complete": {
          "type": "boolean"
        },
        "dropped_context_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "target_complete": {
          "type": "boolean"
        },
        "unevaluated_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "language",
        "target_complete",
        "context_complete",
        "dropped_context_ids",
        "unevaluated_rules"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "UNSUPPORTED_VERSION",
        "POLICY_NOT_FOUND",
        "INVALID_POLICY",
        "UNSUPPORTED_POLICY",
        "MODEL_UNAVAILABLE",
        "DEADLINE_EXCEEDED",
        "RESOURCE_EXHAUSTED",
        "INTERNAL_ERROR"
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "reason_code": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "rule_id",
        "method",
        "reason_code",
        "spans"
      ]
    },
    "Method": {
      "type": "string",
      "enum": [
        "deterministic",
        "model",
        "custom_policy"
      ]
    },
    "Span": {
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "message_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "message_id",
        "start",
        "end"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "assessed",
        "indeterminate",
        "error",
        "cancelled"
      ]
    },
    "Versions": {
      "type": "object",
      "properties": {
        "detectors": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "runtime",
        "model",
        "detectors",
        "registry",
        "policy_id",
        "policy_version"
      ]
    }
  }
}
